TZ=Asia/Shanghai
GOPROXY=https://goproxy.cn,direct

# Must match remote-management.secret-key in config.yaml.
CPA_MANAGEMENT_KEY=replace-with-cli-management-key

API_DOMAIN=aiclient.example.com
MANAGER_DOMAIN=cpa.example.com
API_SSL_CERT=/absolute/path/to/aiclient.example.com.pem
API_SSL_KEY=/absolute/path/to/aiclient.example.com.key
MANAGER_SSL_CERT=/absolute/path/to/cpa.example.com.pem
MANAGER_SSL_KEY=/absolute/path/to/cpa.example.com.key

CLI_PROXY_CONFIG_PATH=./config.yaml
CLI_PROXY_AUTH_PATH=./auths
CLI_PROXY_LOG_PATH=./logs
CLI_PROXY_PLUGIN_PATH=./plugins
CPA_MANAGER_DATA_PATH=./data/cpa-manager-plus

GEMINI_CALLBACK_PORT=8085
CODEX_CALLBACK_PORT=1455
ANTHROPIC_CALLBACK_PORT=54545
KIMI_CALLBACK_PORT=51121
XAI_CALLBACK_PORT=11451

USAGE_QUOTA_COOLDOWN_ENABLED=true
USAGE_ACCOUNT_ACTIONS_ENABLED=true
USAGE_ACCOUNT_ACTIONS_AUTO_DISABLE=false
